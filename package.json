{
  "name": "forword-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run verify && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup:appwrite": "node scripts/setup-appwrite.mjs",
    "verify": "node --check scripts/setup-appwrite.mjs && node --check functions/forword-rewards/src/main.js"
  },
  "dependencies": {
    "appwrite": "^16.0.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "node-appwrite": "^14.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
