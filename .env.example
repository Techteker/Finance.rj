# FORWORD Environment Variables
# Copy to .env and configure your private backend values.
# Architecture: Supabase = Auth + Database | Appwrite = File Storage only

# -----------------------------------------------------------------------------
# Client variables (safe for browser bundle)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_BUCKET_ID=

# Optional Search Engine Verification tokens (public meta tags)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Server-only variables (NEVER prefix with VITE_ or expose to browser)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_BUCKET_ID=forword-media
APPWRITE_API_KEY=

REWARDS_SIGNING_SECRET=
